# Copy to .env.local for local dev; set the same keys in Netlify for production.

# Canonical origin used for canonical/hreflang/sitemap URLs (defaults to https://www.mobisoins.com).
NEXT_PUBLIC_SITE_URL=

# Google Search Console → Settings → Ownership verification → "HTML tag".
# Paste only the content="..." value. Leave empty to render no meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → "Add site" → "HTML Meta Tag" (msvalidate.01 content value).
# Leave empty to render no meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Web3Forms access key for the contact form; messages go to info@mobisoins.com.
# Set it in Netlify with the Builds scope, then redeploy: Next.js bakes NEXT_PUBLIC_*
# values in at build time, so a variable added after the last build has no effect.
NEXT_PUBLIC_FORM_ACCESS_KEY=
